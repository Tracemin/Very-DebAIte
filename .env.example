# --- LLM provider (required for real checks) ---
# OpenAI-compatible base URL, for example https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_DEBATER=
LLM_MODEL_JUDGE=

# --- Server ---
BIND_ADDR=127.0.0.1:3000
# Comma-separated browser origins allowed to use the API. Leave empty for same-origin.
ALLOWED_ORIGIN=
# off | record | replay
DEMO_MODE=off
MAX_CONCURRENT_CHECKS=20
# "<requests>/<window>" separated by a comma, then the per-IP concurrency limit.
# Example: 5/10min,2
RATE_LIMIT_PER_IP=5/10min,2
LOG_LEVEL=info

# --- Paths (optional) ---
DIST_DIR=dist
FIXTURES_DIR=fixtures

# --- Demo recordings (optional, DEMO_MODE=record/replay) ---
# Must match PROMPT_VERSION in crates/server/src/prompts.rs for replay to find fixtures.
